---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  lang: 'ja' | 'en';
  alternates: { ja: string; en: string };
}

const { title, description, lang, alternates } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Seo title={title} description={description} alternates={alternates} />
  </head>
  <body>
    <Header lang={lang} alternates={alternates} />
    <main><slot /></main>
    <Footer />
  </body>
</html>
