---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  lang: 'ja' | 'en';
  alternates: { ja: string; en: string };
}

const { title, description, lang, alternates } = Astro.props;
---

<BaseLayout title={title} description={description} lang={lang} alternates={alternates}>
  <article><slot /></article>
</BaseLayout>
